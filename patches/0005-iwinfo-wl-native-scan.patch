+ static int wl_ioctl(const char *name, int cmd, void *buf, int len)
+ {
+-	struct ifreq ifr;
+-	wl_ioctl_t ioc;
++	struct ifreq ifr = { 0 };
++	wl_ioctl_t ioc = { 0 };
++	struct uci_section *radio;
++	const char *ifname;
++
++	/* LuCI passes the wifi-device section, CLI users pass a netdev. */
++	if (!if_nametoindex(name))
++	{
++		radio = iwinfo_uci_get_radio(name, "broadcom");
++		ifname = radio ? uci_lookup_option_string(uci_ctx, radio, "ifname") : NULL;
++		if (!ifname || strlen(ifname) >= IFNAMSIZ)
++		{
++			iwinfo_uci_free();
++			return -1;
++		}
++		strcpy(ifr.ifr_name, ifname);
++		iwinfo_uci_free();
++	}
++	else
++		strncpy(ifr.ifr_name, name, IFNAMSIZ - 1);
+ 
+ 	/* do it */
+ 	ioc.cmd = cmd;
+ 	ioc.buf = buf;
+ 	ioc.len = len;
++	ioc.set = (cmd == WLC_SCAN);
+ 
+-	strncpy(ifr.ifr_name, name, IFNAMSIZ);
+ 	ifr.ifr_data = (caddr_t) &ioc;
+ 
