++		return -1;
++	res->buflen = WL_SCAN_BUFSIZE;
++	if (!wl_ioctl(ifname, WLC_SCAN_RESULTS, res, WL_SCAN_BUFSIZE))
++		ret = wl_scan_parse(res, WL_SCAN_BUFSIZE, buf, len);
